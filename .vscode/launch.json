{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sample (Local)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "sample",
                "--run_dir", "src/runs/2026-03-29-17-04-45-ZINC",
                "--num_samples", "10",
                "--sample_constant", "5",
                "--load_last"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Sample: Attach to Docker (debugpy)",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ]
        }
    ]
}
